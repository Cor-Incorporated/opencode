{
  "$schema": "https://opencode.ai/config.json",
  "model": {
    "providerID": "zai-coding-plan",
    "model": "glm-5.3"
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "zai-coding-plan",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openai",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "deepseek",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "openrouter",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "cor-local",
      "effect": "allow"
    }
  ],
  "share": "disabled",
  "providers": {
    "zai-coding-plan": {
      "models": {
        "glm-5.2-highspeed": {
          "disabled": true
        },
        "glm-5.3-highspeed": {
          "disabled": true
        }
      }
    },
    "openai": {},
    "deepseek": {},
    "openrouter": {},
    "cor-local": {
      "name": "Cor local (llama-server router / Mac Studio)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:COR_LOCAL_BASE_URL}",
        "apiKey": "{env:COR_LOCAL_API_KEY}",
        "headerTimeout": 900000,
        "timeout": false,
        "chunkTimeout": 120000,
        "provider": "cor-local"
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (local)",
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          }
        },
        "glm53-flash": {
          "name": "GLM 5.3 Flash (local)",
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (local)",
          "limit": {
            "context": 262144,
            "output": 16384
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "capabilities": {
            "tools": true,
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high"]
            }
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "task": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "ask",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "bun *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git stash*": "allow",
      "gh *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "git worktree list*": "allow",
      "git merge-base *": "allow",
      "cat *": "ask",
      "git worktree add *": "ask",
      "git branch -D *": "ask",
      "git branch -d *": "ask",
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "sudo *": "deny",
      "curl * | sh*": "deny",
      "wget * | sh*": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.cer": "deny",
      "*.crt": "deny",
      "*.der": "deny",
      "*.kdbx": "deny",
      "*credentials*": "deny"
    }
  }
}
